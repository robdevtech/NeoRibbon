<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">

  <name>NeoRibbon</name>

  <description>Lightweight ribbon UI for FreeCAD 1.1+. Maps the active workbench toolbars into a compact top ribbon, hides classic toolbars while enabled, and restores them on disable. No external Python dependencies.</description>

  <version>0.2.1</version>

  <date>2026-08-11</date>

  <maintainer email="therobdev@pm.me">Rob</maintainer>

  <license file="LICENSE">LGPL-2.1-or-later</license>

  <pythonmin>3.10.0</pythonmin>

  <icon>Resources/icons/NeoRibbon.svg</icon>

  <url type="repository" branch="master">https://github.com/robdevtech/NeoRibbon</url>

  <url type="readme">https://github.com/robdevtech/NeoRibbon/blob/master/README.md</url>

  <url type="bugtracker">https://github.com/robdevtech/NeoRibbon/issues</url>

  <content>
    <!--
      InitGui-only Mod (not a Workbench class). FreeCAD still needs a
      workbench content item so InitGui.py is executed at GUI startup —
      same pattern as other InitGui-only Mods (e.g. ToolSeek).
    -->
    <workbench>
      <freecadmin>1.1.0</freecadmin>
      <icon>Resources/icons/NeoRibbon.svg</icon>
      <subdirectory>./</subdirectory>
      <tag>ribbon</tag>
      <tag>ui</tag>
    </workbench>
  </content>

</package>
